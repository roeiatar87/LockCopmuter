<Window x:Class="LockCopmuter.Views.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="אזהרה"
        Width="380" Height="160"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#111827">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="אזהרה: המחשב יכבה בקרוב"
                   Foreground="White" FontSize="16" FontWeight="Bold"/>

        <TextBlock Grid.Row="2"
                   Text="{Binding CountdownText}"
                   Foreground="#E2E8F0"
                   FontSize="14"/>

        <TextBlock Grid.Row="3" Margin="0,10,0,0"
                   Text="שמור עבודה וסגור תוכנות פתוחות."
                   Foreground="#94A3B8"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
