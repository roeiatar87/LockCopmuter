<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationIcon>game (1).ico</ApplicationIcon>
	</PropertyGroup>

	<Target Name="BuildAndCopyLockCopmuter" BeforeTargets="Build">
		<!-- Build WPF -->
		<MSBuild Projects="..\LockCopmuter\LockCopmuter.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />

		<!-- Source output folder of WPF -->
		<PropertyGroup>
			<_AppOutDir>..\LockCopmuter\bin\$(Configuration)\net8.0-windows\</_AppOutDir>
		</PropertyGroup>

		<!-- Collect ALL files from WPF output -->
		<ItemGroup>
			<_AppFiles Include="$(_AppOutDir)**\*.*" />
		</ItemGroup>

		<Message Importance="high" Text="Copying WPF output from $(_AppOutDir) to $(OutDir)" />

		<Error Text="WPF output folder not found: $(_AppOutDir)" Condition="!Exists('$(_AppOutDir)')" />

		<Copy SourceFiles="@(_AppFiles)" DestinationFiles="@(_AppFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>

	<ItemGroup>
		<Content Include="game (1).ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>


</Project>
