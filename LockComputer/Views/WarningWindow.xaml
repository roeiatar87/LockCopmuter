<Window x:Class="LockComputer.Views.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="אזהרה"
        Width="420" Height="220"
        MinWidth="420" MinHeight="220"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        FlowDirection="RightToLeft"
        Background="#0F172A">

    <Window.Resources>
        <!-- Brushes (כמו אצלך) -->
        <SolidColorBrush x:Key="TextMain" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Card" Color="#111827"/>
        <SolidColorBrush x:Key="Border" Color="#1F2937"/>
        <SolidColorBrush x:Key="BtnPrimary" Color="#2563EB"/>
        <SolidColorBrush x:Key="BtnSecondary" Color="#334155"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>

        <!-- Button Style עם Hover -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource BtnSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border Background="{StaticResource Card}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="14">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Text="אזהרה"
                           Foreground="{StaticResource TextMain}"
                           FontSize="16"
                           FontWeight="Bold"/>

                <!-- Countdown -->
                <TextBlock Grid.Row="2"
                           Text="{Binding CountdownText}"
                           Foreground="#E2E8F0"
                           FontSize="14"
                           TextWrapping="Wrap"/>

                <!-- Tip -->
                <TextBlock Grid.Row="4"
                           Text="שמור עבודה וסגור תוכנות פתוחות."
                           Foreground="{StaticResource TextMuted}"
                           TextWrapping="Wrap"/>

                <!-- Buttons -->
                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="0,14,0,0">

                    <!-- סגור -->
                    <Button Content="אישור"
                            Width="120"
                            Height="38"
                            Background="{StaticResource BtnPrimary}"
                            Click="Ok_Click"/>

                    <!-- ביטול עם סיסמה -->
                    <Button Content="בטל (סיסמה)"
                            Width="140"
                            Height="38"
                            Margin="10,0,0,0"
                            Visibility="{Binding CancelVisibility}"
                            Click="CancelWithPassword_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
