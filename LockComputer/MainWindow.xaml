<Window x:Class="LockComputer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LockComputer"
        Width="560"
        Height="380"
        MinWidth="520"
        MinHeight="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#0F172A">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border CornerRadius="14" Background="#111827" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="נעילת מחשב" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="#CBD5E1" FontSize="13" Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
        Height="34"
        MinWidth="80"
        Padding="14,0"
        CornerRadius="17"
        Background="{Binding StatusPillBackground}"
        VerticalAlignment="Center">

                    <TextBlock Text="{Binding StatusPillText}"
               Foreground="White"
               FontWeight="SemiBold"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"/>
                </Border>


            </Grid>
        </Border>

        <!-- Body -->
        <Border Grid.Row="2" CornerRadius="14" Background="#111827" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="מידע" Foreground="White" FontSize="16" FontWeight="SemiBold"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="12" Background="#0B1220" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="חלון חסימה הבא" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Text="{Binding NextRestrictionText}" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" CornerRadius="12" Background="#0B1220" Padding="12" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="סטטוס סיסמה" Foreground="#94A3B8" FontSize="12"/>
                            <TextBlock Text="{Binding PasswordStatusText}" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="4" Text="{Binding TipText}"
                           Foreground="#CBD5E1" TextWrapping="Wrap" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Footer buttons -->
        <!-- Footer buttons -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- סגור -->
            <Button Grid.Column="1"
            Content="סגור"
            Command="{Binding CloseWindowCommand}"/>

            <!-- הצג לוג -->
            <Button Grid.Column="3"
            Content="הצג לוג"
            Command="{Binding OpenLogCommand}"/>

            <!-- הגדרות (Primary) -->
            <Button Grid.Column="5"
            Content="הגדרות"
            Style="{StaticResource PrimaryButtonStyle}"
            Command="{Binding OpenSettingsCommand}"/>
        </Grid>

    </Grid>
</Window>
